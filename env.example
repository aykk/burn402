# Your agent's Solana wallet (base58 secret key). Pays the test market on devnet, and the real market
# unless MAINNET_SOLANA_SECRET_KEY is set.
AGENT_SOLANA_SECRET_KEY=
# Optional: a separate wallet for the real market (Solana mainnet USDC).
MAINNET_SOLANA_SECRET_KEY=
# The test seller's receiving address on devnet.
SOLANA_RECEIVER_ADDRESS=
# Optional: an Ethereum-type address where the test seller is paid on Base's test network (Base Sepolia).
# With it set, the test market can also be paid from an Ethereum wallet such as MetaMask. Any address you hold.
BASE_RECEIVER_ADDRESS=
# Optional, for `npm run wallet:test:base` only: a throwaway test key that stands in for MetaMask. Never a real wallet's key.
TEST_BASE_WALLET_SECRET_KEY=
# Where purchase records go on Arweave: testnet (default) or production (mainnet, permanent).
BURN402_ARWEAVE_NETWORK=testnet

# A public demo (see README): the public host names this app answers on, and the test seller in a production build.
# npm run public sets both for you.
BURN402_PUBLIC_HOSTS=
BURN402_TEST_SELLER=

# Optional: the agent wallet that signs for PUBLIC VISITORS on the real market (npm run public -- --real),
# separate from yours so their machines are never on your wallet. It needs no funds.
PUBLIC_MAINNET_SOLANA_SECRET_KEY=
